# /etc/nginx/sites-available/default
# Bài 2: Path-based routing trên cùng 1 domain (cổng 80)
#   /api/...           -> Backend API Gateway  http://localhost:8080
#   mọi đường dẫn khác -> Frontend React       http://localhost:3000

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name domain.com www.domain.com;

    # 1) Request có đường dẫn bắt đầu bằng /api/ -> API Gateway
    #    proxy_pass KHÔNG có "/" ở cuối => Nginx giữ nguyên URI gốc:
    #    /api/products?page=2  ->  http://localhost:8080/api/products?page=2
    location /api/ {
        proxy_pass http://localhost:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;                       # giữ domain gốc (mặc định Nginx gửi "localhost:8080")
        proxy_set_header X-Real-IP         $remote_addr;                # IP thật của client
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;  # nối IP client vào chuỗi X-Forwarded-For
        proxy_set_header X-Forwarded-Proto $scheme;                     # client dùng http hay https
    }

    # 2) Mọi request còn lại: /, /about, /products, /static/... -> Frontend React
    #    "location /" khớp mọi URI nhưng có độ ưu tiên thấp nhất,
    #    nên chỉ nhận những request không khớp location /api/ ở trên.
    location / {
        proxy_pass http://localhost:3000;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
